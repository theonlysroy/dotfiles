{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    "source": "ubuntu_small",
    "color": {
      "1": "white",
      "2": "white",
    },
    "padding": {
      "top": 1,
      "left": 2,
    },
  },
  "display": {
    "separator": ">  ",
    "color": {
      "separator": "",
    },
    "constants": [
      "═══════════════════════════════════════════════════════════════════════════",
      "║\u001b[75C║\u001b[75D",
    ],
  },
  "modules": [
    {
      "format": "════════════════ {user-name-colored}{at-symbol-colored}{host-name-colored} ════════════════",
      "type": "title",
    },
    {
      "key": " kernel   ",
      "type": "kernel",
    },
    {
      "key": "󰅐 uptime   ",
      "type": "uptime",
    },
    {
      "key": "{icon} distro   ",
      "type": "os",
    },
    {
      "key": "󰇄 desktop  ",
      "type": "de",
    },
    {
      "key": " term     ",
      "type": "terminal",
    },
    {
      "key": " shell    ",
      "type": "shell",
    },
    {
      "key": "󰍛 cpu      ",
      "type": "cpu",
      "showPeCoreCount": true,
      "temp": true,
    },
    {
      "key": "󰍛 gpu      ",
      "type": "gpu",
    },
    {
      "key": "󰉉 disk     ",
      "type": "disk",
      "folders": "/",
    },
    {
      "key": " memory   ",
      "type": "memory",
    },
  ],
}
