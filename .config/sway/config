set $mod Mod4
set $term foot
set $menu fuzzel

font pango:JetBrainsMono Nerd Font 10
default_border pixel 2
smart_borders off
gaps inner 6
gaps outer 6
smart_gaps off
floating_modifier $mod normal

output * bg ~/Pictures/wallpapers/night.png fill
#output * bg ~/Pictures/wallpapers/wall.png fill

client.focused          #ff8c42 #1e1e20 #e8e6e3 #ffb574 #ff8c42
client.focused_inactive #3f3f43 #2e2e31 #e8e6e3 #3f3f43 #3f3f43
client.unfocused        #3f3f43 #1e1e20 #8c8c91 #3f3f43 #3f3f43
client.urgent           #ff5c57 #ff5c57 #e8e6e3 #ff5c57 #ff5c57
client.placeholder      #1e1e20 #1e1e20 #e8e6e3 #1e1e20 #1e1e20

input type:keyboard {
    xkb_layout us
    #xkb_options caps:escape
    repeat_delay 250
    repeat_rate 40
}
input type:touchpad {
    tap enabled
    natural_scroll enabled
    dwt enabled
}

# Workspaces to monitors: first output that is connected wins.
# 1-5 live on the external monitor when docked, 6-9 on the laptop panel.
workspace 1 output HDMI-A-1 eDP-1
workspace 2 output HDMI-A-1 eDP-1
workspace 3 output HDMI-A-1 eDP-1
workspace 4 output HDMI-A-1 eDP-1
workspace 5 output HDMI-A-1 eDP-1
workspace 6 output HDMI-A-1 eDP-1
workspace 7 output HDMI-A-1 eDP-1
workspace 8 output HDMI-A-1 eDP-1
workspace 9 output HDMI-A-1 eDP-1

## Terminal
bindsym $mod+Return exec $term
## App launcher
bindsym $mod+space exec $menu
## Browser
bindsym $mod+b exec firefox-esr
## Zed editor
bindsym $mod+e exec zed
## Close window
bindsym $mod+Shift+q kill
## Fullscreen
bindsym $mod+f fullscreen
## Toggle floating
bindsym $mod+Shift+space floating toggle
## Reload Sway config
bindsym $mod+Shift+c reload
## Show this keybinding cheat sheet
bindsym $mod+slash exec ~/.local/bin/keybinds
## Power menu (lock, suspend, logout, reboot, shutdown)
bindsym $mod+Escape exec ~/.local/bin/power-menu
## Lock screen
bindsym $mod+Ctrl+l exec swaylock -f
## Clipboard history
bindsym $mod+c exec cliphist list | fuzzel --dmenu | cliphist decode | wl-copy
## Clipboard: delete one item from history
bindsym $mod+Alt+c exec cliphist list | fuzzel --dmenu --prompt "delete ❯ " | cliphist delete
## Clipboard: clear all history
bindsym $mod+Ctrl+c exec cliphist wipe && wl-copy --clear
## Toggle laptop screen on/off
bindsym $mod+shift+d exec ~/.local/bin/toggle-laptop

## Focus window (vim keys)
bindsym $mod+h focus left
bindsym $mod+j focus down
bindsym $mod+k focus up
bindsym $mod+l focus right
## Move window (vim keys)
bindsym $mod+Shift+h move left
bindsym $mod+Shift+j move down
bindsym $mod+Shift+k move up
bindsym $mod+Shift+l move right

## Switch to workspace 1-9
bindsym $mod+1 workspace number 1
bindsym $mod+2 workspace number 2
bindsym $mod+3 workspace number 3
bindsym $mod+4 workspace number 4
bindsym $mod+5 workspace number 5
bindsym $mod+6 workspace number 6
bindsym $mod+7 workspace number 7
bindsym $mod+8 workspace number 8
bindsym $mod+9 workspace number 9
## Move window to workspace 1-9
bindsym $mod+Shift+1 move container to workspace number 1
bindsym $mod+Shift+2 move container to workspace number 2
bindsym $mod+Shift+3 move container to workspace number 3
bindsym $mod+Shift+4 move container to workspace number 4
bindsym $mod+Shift+5 move container to workspace number 5
bindsym $mod+Shift+6 move container to workspace number 6
bindsym $mod+Shift+7 move container to workspace number 7
bindsym $mod+Shift+8 move container to workspace number 8
bindsym $mod+Shift+9 move container to workspace number 9
## Previous workspace (toggle)
bindsym $mod+Tab workspace back_and_forth
## Next / previous workspace on this monitor
bindsym $mod+bracketright workspace next_on_output
bindsym $mod+bracketleft workspace prev_on_output

## Focus other monitor
bindsym $mod+Left focus output left
bindsym $mod+Right focus output right
## Send window to other monitor
bindsym $mod+Shift+Left move container to output left
bindsym $mod+Shift+Right move container to output right
## Send workspace to other monitor
bindsym $mod+Ctrl+Left move workspace to output left
bindsym $mod+Ctrl+Right move workspace to output right

## Layout: tabbed, stacking, toggle split
bindsym $mod+w layout tabbed
bindsym $mod+s layout stacking
bindsym $mod+t layout toggle split
## Split next window horizontally / vertically
bindsym $mod+backslash splith
bindsym $mod+v splitv
## Send window to scratchpad
bindsym $mod+Shift+minus move scratchpad
## Show / hide scratchpad
bindsym $mod+minus scratchpad show

## Resize mode (h/j/k/l, Esc to leave)
bindsym $mod+r mode "resize"
mode "resize" {
    bindsym h resize shrink width 40px
    bindsym l resize grow width 40px
    bindsym k resize shrink height 40px
    bindsym j resize grow height 40px
    bindsym Return mode "default"
    bindsym Escape mode "default"
}

## Screenshot region to clipboard
bindsym Print exec grim -g "$(slurp)" - | wl-copy
## Screenshot region to ~/Pictures/Screenshots
bindsym $mod+Print exec mkdir -p ~/Pictures/Screenshots && grim -g "$(slurp)" ~/Pictures/Screenshots/$(date +%F_%H-%M-%S).png

## Volume up / down / mute
bindsym --locked XF86AudioRaiseVolume exec wpctl set-volume -l 1.0 @DEFAULT_AUDIO_SINK@ 5%+
bindsym --locked XF86AudioLowerVolume exec wpctl set-volume @DEFAULT_AUDIO_SINK@ 5%-
bindsym --locked XF86AudioMute exec wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle
## Brightness up / down
bindsym --locked XF86MonBrightnessUp exec brightnessctl set 5%+
bindsym --locked XF86MonBrightnessDown exec brightnessctl set 5%-
## Play / pause media
bindsym --locked XF86AudioPlay exec playerctl play-pause

for_window [app_id="(?i).*pavucontrol"] floating enable

# Autostart
exec mako
## exec kanshi
exec kanshi
exec wl-paste --type text --watch cliphist store -max-items 25 store
exec wl-paste --type image --watch cliphist store -max-items 25 store
exec swayidle -w timeout 300 'swaylock -f' timeout 600 'swaymsg "output * power off"' resume 'swaymsg "output * power on"' before-sleep 'swaylock -f'
# exec wlsunset -l 52 -L 5    # optional night light: put your own latitude/longitude

bar {
    swaybar_command waybar
}

## three finger swipe gesture
bindgesture swipe:3:right workspace prev_on_output
bindgesture swipe:3:left workspace next_on_output

## screenshot a region
bindsym $mod+Shift+s exec ~/.local/bin/screenshot area
## Screenshot whole screen
bindsym $mod+Shift+Print exec ~/.local/bin/screenshot full

include /etc/sway/config.d/*
