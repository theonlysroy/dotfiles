{
  "helix_mode": true,
  "word_diff_enabled": true,
  "minimum_split_diff_width": 100.0,
  "indent_guides": {
    "coloring": "fixed",
    "enabled": false
  },
  "show_wrap_guides": true,
  "minimap": {
    "current_line_highlight": "none"
  },
  "inline_code_actions": false,
  "file_finder": {
    "file_icons": false
  },
  "global_lsp_settings": {
    "button": false
  },
  "disable_ai": true,
  "debugger": {
    "button": false
  },
  "diagnostics": {
    "button": false
  },
  "search": {
    "button": false
  },
  "collaboration_panel": {
    "button": false,
    "dock": "left",
  },
  "ui_font_family": "Adwaita Sans",
  "diff_view_style": "split",
  "cli_default_open_behavior": "existing_window",
  "git": {
    "file_diff": {
      "show_full_file": true
    },
    "enable_diff": true,
    "inline_blame": {
      "show_commit_summary": true,
    },
    "disable_git": false,
  },
  "auto_update": false,
  "extend_comment_on_newline": false,
  "edit_predictions": {
    "provider": "none",
    "mode": "subtle",
  },
  "git_panel": {
    "default_width": 240.0,
    "folder_indicator": "chevron",
    "button": false,
    "dock": "left",
  },
  "outline_panel": {
    "folder_indicator": "chevron",
    "button": false,
    "dock": "left",
  },
  "agent": {
    "prevent_idle_sleep": false,
    "threads_sidebar": {
      "auto_open": false
    },
    "button": false,
    "default_model": {
      "provider": "openrouter",
      "model": "qwen/qwen3.5-35b-a3b",
      "enable_thinking": true,
    },
    "dock": "right",
    "favorite_models": [
      {
        "provider": "openrouter",
        "model": "z-ai/glm-5.2",
        "enable_thinking": true,
      },
      {
        "provider": "openrouter",
        "model": "deepseek/deepseek-v4-flash",
        "enable_thinking": true,
      },
    ],
    "model_parameters": [],
  },
  "project_panel": {
    "indent_guides": {
      "show": "never"
    },
    "sticky_scroll": false,
    "show_diagnostics": "off",
    "scrollbar": {
      "horizontal_scroll": false
    },
    "starts_open": false,
    "indent_size": 12.0,
    "git_status": true,
    "entry_spacing": "standard",
    "hide_gitignore": false,
    "default_width": 240.0,
    "sort_order": "default",
    "bold_folder_labels": false,
    "hide_root": false,
    "auto_fold_dirs": true,
    "folder_indicator": "chevron",
    "file_icons": false,
    "button": false,
    "git_status_indicator": false,
    "dock": "left",
  },
  "mouse_wheel_zoom": true,
  "toolbar": {
    "breadcrumbs": false,
    "agent_review": false,
    "code_actions": false,
    "quick_actions": false,
    "selections_menu": false,
  },
  "session": {
    "trust_all_worktrees": true,
  },
  "vim_mode": false,
  "telemetry": {
    "diagnostics": false,
    "metrics": false,
  },
  "base_keymap": "VSCode",
  "icon_theme": "Zed (Default)",
  "ui_font_size": 14.0,
  "buffer_font_size": 13.0,
  // "buffer_font_family": "Red Hat Mono",
  "buffer_font_family": "JetBrainsMono Nerd Font Mono",
  // "buffer_font_family": "Maple Mono NF",
  "terminal": {
    // "font_family": "Maple Mono NF",
    "button": false,
    "font_size": 13.0,
    "font_family": "JetBrainsMono Nerd Font Mono",
    // "font_family": "Red Hat Mono",
    "scrollbar": {
      "show": "auto",
    },
  },
  "buffer_line_height": {
    "custom": 2.2,
  },
  "theme": {
    "mode": "dark",
    "light": "One Light",
    "dark": "Min Dark (Solid)",
  },
  "soft_wrap": "editor_width",
  "scrollbar": {
    "git_diff": false,
    "show": "never",
  },
  "autosave": "off",
  "show_whitespaces": "boundary",
  "restore_on_file_reopen": false,
  "file_scan_exclusions": [
    "**/.svn",
    "**/.hg",
    "**/.jj",
    "**/.repo",
    "**/CVS",
    "**/.DS_Store",
    "**/Thumbs.db",
    "**/.classpath",
    "**/.settings",
  ],
  "experimental.theme_overrides": {
    "syntax": {
      "exception": {
        "font_style": "italic",
      },
      "type.function": {
        "font_style": "italic",
      },
      "function.method": {
        "font_style": "italic",
      },
      "comment": {
        "font_style": "italic",
      },
      "keyword": {
        "font_style": "italic",
      },
      "string": {
        "font_style": "italic",
      },
      "keyword.conditional": {
        "font_style": "italic",
      },
      "keyword.coroutine": {
        "font_style": "italic",
      },
      "keyword.repeat": {
        "font_style": "italic",
      },
      "keyword.exception": {
        "font_style": "italic",
      },
      "keyword.operator": {
        "font_style": "italic",
      },
      "string.escape": {
        "font_style": "italic",
      },
      "boolean": {
        "font_style": "italic",
      },
      "constant": {
        "font_style": "italic",
      },
      "punctuation.special": {
        "font_style": "italic",
      },
      "number": {
        "font_style": "italic",
      },
      "type": {
        "font_style": "italic",
      },
      "variable.builtin": {
        "font_style": "italic",
      },
      "variable.parameter": {
        "font_style": "italic",
      },
    },
  },
  "formatter": "prettier",
  "languages": {
    "SQL": {
      "tab_size": 2,
      "formatter": "prettier",
    },
    "JavaScript": {
      "formatter": "prettier",
    },
    "TypeScript": {
      "hard_tabs": false,
      "tab_size": 2,
      "formatter": "prettier",
      "language_servers": [
        "typescript-ls",
        "!vtsls",
        "!typescript-language-server",
      ],
    },
    "TSX": {
      "formatter": "prettier",
      "language_servers": [
        "typescript-ls",
        "!vtsls",
        "!typescript-language-server",
      ],
    },
    "JSON": { "formatter": "prettier" },
    "JSONC": { "formatter": "prettier" },
    "Go": {
      "auto_indent": "syntax_aware",
      "tab_size": 2,
      "hard_tabs": true,
      "code_actions_on_format": {
        "source.organizeImports": true,
      },
      "format_on_save": "on",
      "formatter": "language_server",
      "debuggers": ["Delve"],
    },
  },
  "gutter": {
    "min_line_number_digits": 0,
    "line_numbers": false,
    "runnables": false,
    "bookmarks": false,
    "breakpoints": false,
    "folds": false,
    "git_gutter_width": {
      "custom": 0.0
    },
  },
}
